# NodeCast - Optimized for TrueNAS Scale with ZFS
FROM node:22-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    musl-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    vips-dev

# Enable pnpm
RUN corepack enable

# Copy package files
COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Generate Prisma client
RUN pnpm prisma generate

# Build application
RUN pnpm run build

# Production stage
FROM node:22-alpine AS runner

WORKDIR /nodecast

# Install runtime dependencies optimized for Alpine
RUN apk add --no-cache \
    vips \
    ffmpeg \
    cairo \
    jpeg \
    pango \
    musl \
    giflib \
    pixman \
    libjpeg-turbo \
    freetype \
    && rm -rf /var/cache/apk/*

# Create nodecast user for security
RUN addgroup -g 1001 -S nodecast \
    && adduser -S nodecast -u 1001

# Enable pnpm
RUN corepack enable

# Copy built application
COPY --from=builder /build/build ./build
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/prisma ./prisma
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/public ./public

# Create directories with proper permissions
RUN mkdir -p /nodecast/uploads /nodecast/temp /nodecast/themes \
    && chown -R nodecast:nodecast /nodecast

# Copy entrypoint script
COPY <<EOF /nodecast/entrypoint.sh
#!/bin/sh
set -e

# Wait for database
echo "Waiting for database..."
while ! nc -z \${DATABASE_HOST:-postgres} \${DATABASE_PORT:-5432}; do
  sleep 1
done

# Run migrations
echo "Running database migrations..."
pnpm prisma migrate deploy

# Start application
echo "Starting NodeCast..."
exec node --require dotenv/config ./build/server
EOF

RUN chmod +x /nodecast/entrypoint.sh

# Set user
USER nodecast

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/healthcheck || exit 1

# ZFS optimized environment variables
ENV NODE_ENV=production \
    CORE_HOSTNAME=0.0.0.0 \
    CORE_PORT=3000 \
    # Optimize for ZFS compression
    NODE_OPTIONS="--max-old-space-size=1536" \
    # Enable V8 optimization flags
    NODE_OPTIONS="${NODE_OPTIONS} --optimize-for-size"

# Labels for TrueNAS Scale
LABEL org.opencontainers.image.title="NodeCast" \
      org.opencontainers.image.description="High-performance file sharing server optimized for ZFS storage" \
      org.opencontainers.image.version="4.3.1" \
      org.opencontainers.image.source="https://github.com/InfamousMorningstar/NodeCase" \
      com.truenas.scale.category="Media" \
      com.truenas.scale.min_scale_version="22.12.0"

ENTRYPOINT ["/nodecast/entrypoint.sh"]